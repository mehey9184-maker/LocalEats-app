rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // CORE AUTHENTICATION & RELATIONSHIP HELPERS
    // =====================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resolves shop ownership via /shops document regardless of numeric vs string shop_id
    function isShopOwner(shopId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/shops/$(string(shopId))) &&
        get(/databases/$(database)/documents/shops/$(string(shopId))).data.owner_id == request.auth.uid;
    }

    // Resolves order participant (Customer, Assigned Rider, or Merchant)
    function isOrderParticipant(orderId) {
      let orderPath = /databases/$(database)/documents/orders/$(string(orderId));
      return isAuthenticated() && exists(orderPath) && (
        get(orderPath).data.user_id == request.auth.uid ||
        get(orderPath).data.rider_id == request.auth.uid ||
        isShopOwner(get(orderPath).data.shop_id)
      );
    }

    // Includes deleted fields: a client must not remove an immutable field.
    function unchanged(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    // Locks server-authoritative rider stats, verification, and ratings
    function riderFinancialsAndRatingsUnchanged() {
      return unchanged('total_earnings') &&
             unchanged('total_deliveries') &&
             unchanged('active_points') &&
             unchanged('rating') &&
             unchanged('verification_status');
    }

    // Default fallback - Secure by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // 1. SHOPS
    // =====================================================================
    match /shops/{shopId} {
      // Public read for customer storefront discovery & vendor sync
      allow read: if true;
      // New shop provisioning and approval belong to the trusted platform API.
      allow create, delete: if false;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid &&
        unchanged('owner_id') &&
        unchanged('approval_status') &&
        unchanged('archived_at') &&
        unchanged('is_verified') &&
        unchanged('is_approved') &&
        unchanged('subscription_tier') &&
        unchanged('subscription_status');
    }

    // =====================================================================
    // 2. MENU ITEMS
    // =====================================================================
    match /menu_items/{itemId} {
      // Public read for customer ordering & rider inspection
      allow read: if true;
      // Write access restricted to the authenticated shop owner
      allow create: if isShopOwner(request.resource.data.shop_id);
      allow update: if isShopOwner(resource.data.shop_id) && unchanged('shop_id');
      allow delete: if isShopOwner(resource.data.shop_id);
    }

    // =====================================================================
    // 3. ORDERS
    // =====================================================================
    match /orders/{orderId} {
      // Read access: Customers read own orders, Merchants read shop orders, Riders read pool or assigned
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.rider_id == request.auth.uid ||
        isShopOwner(resource.data.shop_id)
      );

      // Order creation is strictly server-authoritative via createOrder Cloud Function
      allow create: if false;

      // The pickup API owns all order transitions and financial state.
      allow update: if false;

      allow delete: if false;
    }

    // =====================================================================
    // 4. USERS (PROFILES)
    // =====================================================================
    match /users/{userId} {
      // Authenticated users read and write only their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Clients may create ordinary accounts, never an elevated role or approval.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.get('role', 'customer') in ['customer', 'user'] &&
        request.resource.data.get('is_admin', false) == false &&
        request.resource.data.get('is_vendor', false) == false &&
        request.resource.data.get('is_merchant', false) == false &&
        !request.resource.data.keys().hasAny(['permissions', 'claims', 'admin_roles']);
      // App profile editing must not grant permissions, shops, credit or rewards.
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        unchanged('role') && unchanged('is_admin') && unchanged('is_vendor') &&
        unchanged('is_merchant') && unchanged('permissions') && unchanged('claims') &&
        unchanged('shop_id') && unchanged('permanent_owner_id') &&
        unchanged('approval_status') && unchanged('verification_status') &&
        unchanged('loyaltyPoints') && unchanged('wallet_balance');
      allow delete: if false;
    }

    // =====================================================================
    // 5. RIDER PROFILES (Includes live telemetry current_latitude / current_longitude)
    // =====================================================================
    // ARCHITECTURAL LIMITATION NOTE:
    // The Merchant Dashboard queries connected drivers via .in("id", riderIds) and
    // reads live telemetry directly from rider_profiles. Firestore rules cannot perform
    // cross-collection JOINs inside IN queries.
    // Sensitive fields: phone, full_name, current_latitude, current_longitude.
    // FUTURE FIX: Mirror delivery telemetry to orders/{orderId}.rider_location and
    // embed driver display info in rider_connections.
    match /rider_profiles/{riderId} {
      // Private rider details are visible only to their own authenticated account.
      allow read: if isAuthenticated() && request.auth.uid == riderId;
      // Rider creates their own profile document
      allow create: if isAuthenticated() && request.auth.uid == riderId &&
                    request.resource.data.id == riderId &&
                    request.resource.data.get('verification_status', 'pending') == 'pending' &&
                    request.resource.data.get('total_earnings', 0) == 0 &&
                    request.resource.data.get('total_deliveries', 0) == 0 &&
                    request.resource.data.get('active_points', 0) == 0 &&
                    request.resource.data.get('rating', 0) == 0;
      // Path identity is authoritative; a forged id field cannot grant access.
      allow update: if isAuthenticated() && request.auth.uid == riderId &&
                    unchanged('id') && riderFinancialsAndRatingsUnchanged();
      allow delete: if false;
    }

    // =====================================================================
    // 6. RIDER CONNECTIONS
    // =====================================================================
    match /rider_connections/{connId} {
      allow read: if isAuthenticated() && (
        resource.data.rider_id == request.auth.uid ||
        isShopOwner(resource.data.shop_id)
      );

      // Merchant creates pairing invitation for their own shop
      allow create: if isShopOwner(request.resource.data.shop_id);

      // Updates: Merchant manages pairing; Rider only updates operational status
      allow update: if (isShopOwner(resource.data.shop_id) && unchanged('shop_id') && unchanged('rider_id')) ||
        (isAuthenticated() && resource.data.rider_id == request.auth.uid &&
         unchanged('shop_id') &&
         unchanged('rider_id') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'active_mission_id', 'updated_at']));

      // Deletion restricted to the shop owner
      allow delete: if isShopOwner(resource.data.shop_id);
    }

    // The legacy Merchant client represents a shop sender by its shop ID,
    // whereas customers and riders use their own Firebase UID.
    function validChatSender(data) {
      let orderData = get(/databases/$(database)/documents/orders/$(string(data.order_id))).data;
      return (
        (data.sender_type == 'shop' &&
         isShopOwner(orderData.shop_id) &&
         data.sender_id == string(orderData.shop_id) &&
         string(data.shop_id) == string(orderData.shop_id)) ||
        (data.sender_type == 'customer' &&
         orderData.user_id == request.auth.uid &&
         data.sender_id == request.auth.uid) ||
        (data.sender_type == 'rider' &&
         orderData.rider_id == request.auth.uid &&
         data.sender_id == request.auth.uid)
      );
    }

    // =====================================================================
    // 7. CHAT MESSAGES
    // =====================================================================
    match /chat_messages/{messageId} {
      // Reading restricted to verified order participants
      allow read: if isAuthenticated() && isOrderParticipant(resource.data.order_id);

      // Creation validates order participation using the incoming request payload
      allow create: if isAuthenticated() &&
                    isOrderParticipant(request.resource.data.order_id) &&
                    validChatSender(request.resource.data);

      // Updates strictly restricted to read-receipt timestamps
      allow update: if isAuthenticated() && isOrderParticipant(resource.data.order_id) &&
                    unchanged('order_id') &&
                    unchanged('sender_id') &&
                    unchanged('content') &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'read_at', 'updated_at']);

      allow delete: if false;
    }

    // =====================================================================
    // 8. SHOP FOLLOWERS
    // =====================================================================
    match /shop_followers/{followId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isShopOwner(resource.data.shop_id)
      );
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid &&
                    unchanged('user_id') && unchanged('shop_id');
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // =====================================================================
    // 9. PAYMENTS (Merchant Payout History)
    // =====================================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && isShopOwner(resource.data.shop_id);
      allow write: if false; // Server-only via payment gateway / Cloud Function
    }
  }
}
