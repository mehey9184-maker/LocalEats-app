# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: The public anon key for your Supabase project.
VITE_SUPABASE_ANON_KEY="your-anon-key"

# MAPBOX_ACCESS_TOKEN: Public access token for Mapbox Cycling Routing
VITE_MAPBOX_ACCESS_TOKEN="your-mapbox-access-token"

# FIREBASE CONFIGURATION (FCM Push Notifications & Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=localeats-5e26e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=localeats-5e26e
VITE_FIREBASE_STORAGE_BUCKET=localeats-5e26e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=281496568360
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-localeatsvendord-a61b068b-3029-4d93-ba41-626b03a23bbe

# SENTRY DSN
VITE_SENTRY_DSN=

# SERVER-ONLY SUPABASE CONFIGURATION (Service Role for Admin backend tasks)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
