rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isShopOwner(shopId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/shops/$(shopId)).data.owner_id == request.auth.uid ||
        get(/databases/$(database)/documents/shops/$(shopId)).data.user_id == request.auth.uid
      );
    }

    // Default deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles Collection
    match /profiles/{userId} {
      // Users can read any basic profile; write ONLY their own
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Shops / Stores / Merchants / Vendors (Publicly browseable, owner-writable)
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        !('owner_id' in request.resource.data) ||
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.user_id == request.auth.uid
      );

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAuthenticated();
      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if isAuthenticated();
      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuthenticated();
      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // 3. Menu Items (Publicly browseable, authenticated shop management)
    match /menu_items/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.shop_id is string;
      allow update, delete: if isAuthenticated();
    }

    // 4. Orders Collection (Customer & Merchant isolated)
    match /orders/{orderId} {
      // Read access requires ownership or assignment
      allow get: if isAuthenticated() && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('rider_id', '') == request.auth.uid ||
        resource.data.get('customer_id', '') == request.auth.uid
      );

      // List queries are strictly scoped: customers only see their orders, riders see assigned orders
      allow list: if isAuthenticated() && (
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('rider_id', '') == request.auth.uid ||
        resource.data.get('customer_id', '') == request.auth.uid
      );

      // Order creation: authenticated user must be author (user_id must match auth UID)
      allow create: if isAuthenticated() &&
        request.resource.data.get('shop_id', null) != null &&
        request.resource.data.get('user_id', '') == request.auth.uid;

      // Order updates: customer status transitions
      allow update: if (
        // Customer canceling their own pending order, marking as completed, or converting to delivery
        isAuthenticated() && resource.data.get('user_id', '') == request.auth.uid && (
          // 1. Cancellation
          (
            request.resource.data.get('status', '') == 'cancelled' &&
            resource.data.get('status', '') == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellation_reason', 'updated_at'])
          )
          ||
          // 2. Mark as Completed
          (
            request.resource.data.get('status', '') == 'completed' &&
            (resource.data.get('status', '') == 'ready' || resource.data.get('status', '') == 'delivering') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
          )
          ||
          // 3. Convert to Delivery
          (
            request.resource.data.get('is_delivery', false) == true &&
            resource.data.get('is_delivery', false) != true &&
            request.resource.data.get('delivery_status', '') == 'finding_rider' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_delivery', 'delivery_status', 'delivery_fee', 'updated_at'])
          )
        )
      );

      // Deletions are forbidden to protect financial and order history
      allow delete: if false;
    }

    // 5. Rider Locations (Real-time telemetry for tracking maps)
    match /rider_locations/{riderId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.auth.uid == riderId ||
        request.resource.data.rider_id == request.auth.uid ||
        !('rider_id' in request.resource.data)
      );
    }

    // 6. Direct In-App Chat Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.order_id is string && (
        request.resource.data.message is string || request.resource.data.text is string
      );
      allow update, delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    // 7. Device Push Notification Tokens
    match /user_push_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create, update: if request.resource.data.token is string;
      allow delete: if isAuthenticated();
    }
  }
}
